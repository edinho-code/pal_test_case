# Copy this file to .env and add credentials from Tavus PAL Maker.
# Keep .env private; the API key is only read by the backend.
# On Vercel, configure these names as server-side environment variables.
TAVUS_API_KEY=
TAVUS_PAL_ID=
# Optional when the PAL already has a default Face.
TAVUS_FACE_ID=
# true creates an ended, no-cost API test; false starts a live PAL session.
TAVUS_TEST_MODE=true
